    "def separate_indices(s):\n",
    "    even_chars = s[::2]  \n",
    "    odd_chars = s[1::2]  \n",
    "    print(even_chars, odd_chars)\n",
    "\n",
    "# Number of test cases\n",
    "n = int(input())\n",
    "\n",
    "for i in range(n):\n",
    "    s = input()\n",
    "    separate_indices(s)\n"
   ]
